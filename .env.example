# ==============================================================================
# PUCIT Class CMS — Environment Configuration Template
# Copy this file to .env and configure appropriate values for your deployment.
# NEVER commit .env to version control or expose production secrets.
# ==============================================================================

# Core Django Settings
# Generate a secure 50+ character random key for production:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY="replace-with-a-cryptographically-secure-random-50-character-key"

# Set to False in production
DJANGO_DEBUG="False"

# Comma-separated list of fully qualified hostnames/domains
DJANGO_ALLOWED_HOSTS="cms.pucit.edu.pk,127.0.0.1"

# Comma-separated list of trusted origins for CSRF (must include https:// scheme)
DJANGO_CSRF_TRUSTED_ORIGINS="https://cms.pucit.edu.pk"

# HTTPS / SSL Security Settings
# Enable when HTTPS is fully configured and working on the domain
DJANGO_SECURE_SSL_REDIRECT="True"
DJANGO_SESSION_COOKIE_SECURE="True"
DJANGO_CSRF_COOKIE_SECURE="True"

# HTTP Strict Transport Security (HSTS)
# Start conservatively (e.g. 3600 = 1 hour, or 86400 = 1 day) before increasing to 31536000 (1 year)
DJANGO_SECURE_HSTS_SECONDS="3600"
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS="False"
DJANGO_SECURE_HSTS_PRELOAD="False"

# Reverse Proxy / Forwarded Header (Enable ONLY if behind Nginx/Caddy/Cloudflare/AWS ALB)
DJANGO_USE_X_FORWARDED_PROTO="False"

# Email / SMTP Configuration
# In production, use "django.core.mail.backends.smtp.EmailBackend"
DJANGO_EMAIL_BACKEND="django.core.mail.backends.smtp.EmailBackend"
EMAIL_HOST="smtp.office365.com"
EMAIL_PORT="587"
EMAIL_USE_TLS="True"
EMAIL_USE_SSL="False"
EMAIL_HOST_USER="cms-alerts@pucit.edu.pk"
EMAIL_HOST_PASSWORD="replace-with-secure-smtp-password"
DEFAULT_FROM_EMAIL="PUCIT Class CMS <cms-alerts@pucit.edu.pk>"

# Optional Database URL / Configuration (defaults to SQLite if unset)
# DATABASE_URL="postgres://user:password@localhost:5432/class_cms"

